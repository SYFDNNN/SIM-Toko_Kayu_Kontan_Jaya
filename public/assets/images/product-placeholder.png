<svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg">
  <rect width="200" height="200" fill="#fef3c7"/>
  <!-- Table silhouette -->
  <rect x="30" y="100" width="140" height="12" rx="4" fill="#d97706" opacity="0.7"/>
  <rect x="50" y="112" width="16" height="55" rx="4" fill="#92400e" opacity="0.6"/>
  <rect x="134" y="112" width="16" height="55" rx="4" fill="#92400e" opacity="0.6"/>
  <!-- Grain lines on table -->
  <line x1="30" y1="104" x2="170" y2="104" stroke="#b45309" stroke-width="0.8" opacity="0.4"/>
  <line x1="30" y1="108" x2="170" y2="108" stroke="#b45309" stroke-width="0.8" opacity="0.4"/>
  <!-- Wood grain pattern on top -->
  <rect x="40" y="85" width="120" height="18" rx="3" fill="#b45309" opacity="0.3"/>
  <!-- Label -->
  <text x="100" y="60" text-anchor="middle" font-family="Arial" font-size="11" fill="#92400e" opacity="0.8">Produk</text>
  <text x="100" y="175" text-anchor="middle" font-family="Arial" font-size="10" fill="#b45309" opacity="0.6">Toko Kayu Kontan Jaya</text>
</svg>
